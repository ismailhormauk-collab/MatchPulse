{
  "name": "matchpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run articles:index && next dev",
    "build": "npm run articles:index && next build",
    "start": "next start",
    "lint": "eslint",
    "test:time": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-time.mjs",
    "test:api": "node --import ./scripts/test-loader.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-api-football.mjs",
    "test": "npm run test:time && npm run test:api && npm run test:feed && npm run test:pages && npm run test:storage && npm run test:external-news && npm run test:articles && npm run articles:index -- --check",
    "api:check": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/api-football-check.mjs",
    "test:feed": "node --import ./scripts/test-loader.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-match-feed.mjs",
    "test:pages": "node --import ./scripts/test-loader.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-pages.mjs",
    "api:sync-assets": "node --env-file-if-exists=.env.local --import ./scripts/test-loader.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/api-football-sync-assets.mjs",
    "test:routes": "node scripts/check-routes.mjs",
    "test:storage": "node --import ./scripts/test-loader.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-storage.mjs",
    "test:external-news": "node --import ./scripts/test-loader.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-external-news.mjs",
    "test:articles": "node --import ./scripts/test-loader.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-articles.mjs",
    "articles:index": "node --import ./scripts/test-loader.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-article-index.mjs",
    "test:deployment": "node scripts/check-deployment.mjs",
    "test:secrets": "node scripts/check-bundle-secrets.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
