# Copy to .env.local and fill in. Never commit real keys.
# Server-only: do not rename with a NEXT_PUBLIC_ prefix.

# API-Football (API-Sports) key from https://dashboard.api-football.com
API_FOOTBALL_KEY=your-api-football-key-here

# "sample" (default) shows labelled development data and makes no API calls.
# "api-football" uses real fixtures when API_FOOTBALL_KEY is set. Rebuild after changing.
MATCHPULSE_DATA_SOURCE=sample

# Seasons outside the API plan's window (learned from the provider's own
# "try from 2022 to 2024" message) are never requested. After upgrading the
# API-Football plan, set this to "all" (or re-run npm run api:sync-assets).
# API_FOOTBALL_PLAN_SEASONS=all

# Optional tuning (seconds). Defaults fit the free plan's 100 requests/day.
# API_FOOTBALL_REVALIDATE_TODAY_SECONDS=1200
# API_FOOTBALL_REVALIDATE_LIVE_SECONDS=120
# API_FOOTBALL_TIMEOUT_MS=8000

# Public origin used for canonical URLs, the sitemap and Open Graph (no trailing path).
# MATCHPULSE_SITE_URL=https://www.example.com

# Vercel Preview/Development deployments never call API-Football (even when a key
# is set for all environments) unless this is "true". Leave unset.
# MATCHPULSE_PREVIEW_LIVE_DATA=true

# Search-engine indexing. Leave unset (or anything but "true") for local, preview
# and staging builds; set to "true" only for the real production deployment.
# MATCHPULSE_ALLOW_INDEXING=true

# Persistent folder for runtime data: match reports (match-reports/) and the
# known-fixture index used for real 404s. Default: .data in the project.
# MATCHPULSE_DATA_DIR=/var/lib/matchpulse
# Optional: put reports somewhere else.
# MATCHPULSE_REPORTS_DIR=/var/lib/matchpulse/match-reports

# Shared storage for deployed (serverless) environments: Upstash Redis REST
# credentials, server-side only. Vercel's Upstash integration may provide them
# as KV_REST_API_URL / KV_REST_API_TOKEN instead; both are supported.
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# Optional: force a storage backend (redis | filesystem | none) and set the
# Redis key prefix (e.g. matchpulse-preview for Preview deployments).
# MATCHPULSE_STORAGE=redis
# MATCHPULSE_STORAGE_PREFIX=matchpulse

# NewsData.io key for the "Latest Football News" section (external headlines
# that link to their publishers). Server-only: never use a NEXT_PUBLIC_ prefix.
# Leave empty to hide the section. Refreshed at most hourly (~24 of the free
# plan's 200 daily credits). Vercel: set for Production only.
NEWSDATA_API_KEY=
# Set to "off" to hide the section without removing the key.
# MATCHPULSE_EXTERNAL_NEWS=off
